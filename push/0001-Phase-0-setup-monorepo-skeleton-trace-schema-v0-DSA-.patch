diff --git a/runflow/sandbox/Dockerfile b/runflow/sandbox/Dockerfile
new file mode 100644
index 0000000..5631ea7
--- /dev/null
+++ b/runflow/sandbox/Dockerfile
@@ -0,0 +1,8 @@
+# Phase 0 seed. Hardening flags live in run-sandbox.sh (single source of truth).
+# Final image will use a jlink'd minimal JDK runtime (verified in Spikes S3/S4).
+FROM eclipse-temurin:17-jdk-jammy
+RUN useradd --create-home --uid 1000 runner
+WORKDIR /sandbox
+COPY --chown=runner:runner . /sandbox/
+USER runner
+ENTRYPOINT ["java", "-cp", "/sandbox", "Main"]
diff --git a/runflow/sandbox/gvisor-setup.md b/runflow/sandbox/gvisor-setup.md
new file mode 100644
index 0000000..e00c5c3
--- /dev/null
+++ b/runflow/sandbox/gvisor-setup.md
@@ -0,0 +1,12 @@
+# gVisor setup (dev VM only — never your main machine)
+
+1. Install Docker per distro docs.
+2. Install `runsc` (https://gvisor.dev/docs) and register it in `/etc/docker/daemon.json`:
+   ```json
+   { "runtimes": { "runsc": { "path": "/usr/local/bin/runsc" } } }
+   ```
+3. `sudo systemctl restart docker`
+4. Smoke test: `docker run --runtime=runsc hello-world`
+5. Confirm fallback policy: if `runsc` is missing, `run-sandbox.sh` must FAIL (no silent runc).
+
+Phase 0 exit criterion: smoke test passes on the dev VM. (Cannot be done from this container.)
diff --git a/runflow/sandbox/run-sandbox.sh b/runflow/sandbox/run-sandbox.sh
new file mode 100755
index 0000000..98337fd
--- /dev/null
+++ b/runflow/sandbox/run-sandbox.sh
@@ -0,0 +1,21 @@
+#!/usr/bin/env bash
+# Single source of truth for docker sandbox flags (vault: Sandbox Hardening Spec).
+# Run only on the dev VM. Use with gVisor: add --runtime=runsc when available.
+set -euo pipefail
+IMAGE="${IMAGE:-runflow-sandbox:dev}"
+SRC_DIR="${1:?usage: run-sandbox.sh <dir-with-Main.java>}"
+docker build -t "$IMAGE" "$SRC_DIR"
+exec docker run \
+  --runtime=runsc \
+  --rm -i \
+  --network=none \
+  --read-only \
+  --cap-drop=ALL \
+  --security-opt=no-new-privileges \
+  --pids-limit=64 \
+  --memory=256m \
+  --memory-swap=256m \
+  --cpus=1 \
+  --tmpfs /tmp:size=16m \
+  -w /sandbox \
+  "$IMAGE"
