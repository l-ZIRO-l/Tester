{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runflow.local/schemas/trace.schema.json",
  "title": "RunFlow Trace (v0, derived from Trace JSON Contract)",
  "type": "object",
  "required": ["schemaVersion", "status", "meta", "graph", "steps"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": {
      "type": "string",
      "enum": [
        "SUCCESS",
        "COMPILE_ERROR",
        "REJECTED",
        "TIME_LIMIT_EXCEEDED",
        "STEP_LIMIT_EXCEEDED",
        "OUTPUT_LIMIT_EXCEEDED",
        "MEMORY_LIMIT_EXCEEDED",
        "RECURSION_DEPTH_LIMIT",
        "RUNTIME_EXCEPTION",
        "INTERNAL_ERROR"
      ]
    },
    "message": { "type": ["string", "null"] },
    "meta": {
      "type": "object",
      "required": ["compileMs", "runMs", "totalSteps", "truncated", "keyframeEvery"],
      "additionalProperties": false,
      "properties": {
        "compileMs": { "type": "integer", "minimum": 0 },
        "runMs": { "type": "integer", "minimum": 0 },
        "totalSteps": { "type": "integer", "minimum": 0 },
        "truncated": { "type": "boolean" },
        "keyframeEvery": { "type": "integer", "minimum": 1 }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["line", "message", "severity"],
        "additionalProperties": false,
        "properties": {
          "line": { "type": "integer", "minimum": 1 },
          "col": { "type": ["integer", "null"], "minimum": 1 },
          "message": { "type": "string" },
          "severity": { "type": "string", "enum": ["error", "warning"] }
        }
      }
    },
    "graph": {
      "type": "object",
      "required": ["methods", "nodes", "edges"],
      "additionalProperties": false,
      "properties": {
        "methods": { "type": "array", "items": { "type": "string" } },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "method", "type", "label", "lineStart", "lineEnd"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "method": { "type": "string" },
              "type": {
                "type": "string",
                "enum": ["START", "END", "ACTION", "DECISION", "CALL", "RETURN", "THROW"]
              },
              "label": { "type": "string" },
              "lineStart": { "type": "integer", "minimum": 1 },
              "lineEnd": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "from", "to"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "from": { "type": "string" },
              "to": { "type": "string" },
              "label": {
                "type": ["string", "null"],
                "enum": ["Yes", "No", "Loop Back", "Break", "Continue", "Exception", "Case", null]
              }
            }
          }
        }
      }
    },
    "pointerHints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["method", "array", "indexVars"],
        "additionalProperties": false,
        "properties": {
          "method": { "type": "string" },
          "array": { "type": "string" },
          "indexVars": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "steps": {
      "type": "array",
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "value": {
      "oneOf": [
        {
          "type": "object",
          "required": ["t", "v"],
          "additionalProperties": false,
          "properties": {
            "t": {
              "type": "string",
              "enum": ["int", "long", "double", "float", "short", "byte", "boolean", "char"]
            },
            "v": {}
          }
        },
        {
          "type": "object",
          "required": ["t", "v"],
          "additionalProperties": false,
          "properties": {
            "t": { "const": "str" },
            "v": { "type": "string" },
            "trunc": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "required": ["t"],
          "additionalProperties": false,
          "properties": { "t": { "const": "null" } }
        },
        {
          "type": "object",
          "required": ["t", "id"],
          "additionalProperties": false,
          "properties": {
            "t": { "const": "ref" },
            "id": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["t", "n"],
          "additionalProperties": false,
          "properties": {
            "t": { "const": "more" },
            "n": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "heapObject": {
      "type": "object",
      "required": ["kind", "cls"],
      "additionalProperties": true,
      "properties": {
        "kind": { "type": "string", "enum": ["ARRAY", "OBJECT", "STRING_BUILDER", "COLLECTION"] },
        "cls": { "type": "string" }
      }
    },
    "frame": {
      "type": "object",
      "required": ["frame", "method", "line", "locals"],
      "additionalProperties": false,
      "properties": {
        "frame": { "type": "string" },
        "method": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "locals": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/value" }
        }
      }
    },
    "step": {
      "type": "object",
      "required": ["i", "kind", "stack"],
      "additionalProperties": false,
      "properties": {
        "i": { "type": "integer", "minimum": 0 },
        "kind": { "type": "string", "enum": ["LINE", "CALL", "RETURN", "EXCEPTION"] },
        "line": { "type": ["integer", "null"], "minimum": 1 },
        "node": { "type": ["string", "null"] },
        "viaEdge": { "type": ["string", "null"] },
        "ret": { "anyOf": [{ "$ref": "#/$defs/value" }, { "type": "null" }] },
        "stack": { "type": "array", "items": { "$ref": "#/$defs/frame" } },
        "heap": {
          "type": ["object", "null"],
          "additionalProperties": { "$ref": "#/$defs/heapObject" }
        },
        "heapDiff": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "set": {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/heapObject" }
            },
            "del": { "type": "array", "items": { "type": "string" } }
          }
        },
        "stdoutAppend": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "i": { "const": 0 } } },
          "then": { "required": ["heap"] }
        },
        {
          "not": {
            "allOf": [
              { "required": ["heap"] },
              { "properties": { "heap": { "type": "object" } } },
              { "required": ["heapDiff"] },
              { "properties": { "heapDiff": { "type": "object" } } }
            ]
          }
        }
      ]
    }
  }
}
